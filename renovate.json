{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Asia/Tokyo",
  "baseBranchPatterns": ["staging"],
  "schedule": ["before 9am on monday"],
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on monday"]
  },
  "packageRules": [
    {
      "description": "Group Cloudflare/OpenNext deployment tooling into a single PR",
      "matchPackageNames": ["wrangler", "@opennextjs/cloudflare", "@cloudflare/workers-types"],
      "groupName": "cloudflare tooling"
    }
  ]
}
