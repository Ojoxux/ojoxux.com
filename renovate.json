{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Asia/Tokyo",
  "baseBranchPatterns": ["staging"],
  "schedule": ["on monday"],
  "prHourlyLimit": 0,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "rebaseWhen": "behind-base-branch",
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["on monday"]
  },
  "packageRules": [
    {
      "description": "Group Cloudflare deployment tooling into a single PR",
      "matchPackageNames": ["wrangler", "@cloudflare/vite-plugin", "@cloudflare/workers-types"],
      "groupName": "cloudflare tooling"
    }
  ]
}
