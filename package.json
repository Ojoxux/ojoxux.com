{
	"name": "ojoxux.com",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "scripts/build.sh",
		"build:wasm": "scripts/build-wasm.sh",
		"watch:fe": "scripts/watch-fe.sh",
		"gen:types": "scripts/gen-types.sh",
		"preview": "vite preview",
		"deploy:prod": "WRANGLER_CONFIG=wrangler.prod.jsonc scripts/build.sh && wrangler d1 migrations apply ojoxux-com-prod-db --config wrangler.prod.jsonc --remote && wrangler deploy",
		"test": "vitest run",
		"test:hs": "cabal test ojoxux-api:test:api-test fe:test:fe-core-test",
		"typecheck": "tsc -p tsconfig.json && tsc -p worker/tsconfig.json",
		"db:migrate:local": "wrangler d1 migrations apply ojoxux-com-prod-db --local",
		"format": "biome format --write",
		"format:check": "biome format",
		"lint": "biome lint",
		"check": "biome check"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@bjorn3/browser_wasi_shim": "^0.4.2",
		"@cloudflare/vite-plugin": "^1.64.0",
		"@cloudflare/workers-types": "^5.20261016.1",
		"@types/node": "^24.0.0",
		"typescript": "^5.7.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.5",
		"wrangler": "^4.151.1"
	},
	"dependencies": {
		"hono": "^4.13.13"
	}
}
