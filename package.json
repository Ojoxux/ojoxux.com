{
	"name": "ojoxux.com",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"deploy:prod": "WRANGLER_CONFIG=wrangler.prod.jsonc pnpm run build && wrangler d1 migrations apply ojoxux-com-prod-db --config wrangler.prod.jsonc --remote && wrangler deploy",
		"test": "vitest run",
		"typecheck": "tsc -p tsconfig.json && tsc -p worker/tsconfig.json",
		"db:migrate:local": "wrangler d1 migrations apply ojoxux-com-prod-db --local",
		"format": "biome format --write",
		"format:check": "biome format",
		"lint": "biome lint",
		"check": "biome check"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@cloudflare/vite-plugin": "^1.64.0",
		"@cloudflare/workers-types": "^5.20261016.1",
		"@effect/vitest": "^4.1.6",
		"@types/node": "^26.0.0",
		"typescript": "^7.0.0",
		"vite": "^8.3.4",
		"vitest": "^5.0.5",
		"wrangler": "^4.151.1"
	},
	"dependencies": {
		"@effect/ui": "https://pkg.pr.new/Effect-TS/ui/@effect/ui@22128c6",
		"effect": "^4.1.6",
		"hono": "^4.13.13"
	}
}
